{
  "name": "@quokkapride/poppr",
  "version": "0.3.3",
  "description": "Understand your own AI slop. A three-minute quiz on the engineering concepts in your PR, generated locally from your diff. Optionally required before merge.",
  "keywords": [
    "pull-request",
    "code-review",
    "github-action",
    "code-quality",
    "open-source",
    "maintainer",
    "contributor",
    "quiz",
    "learning",
    "spaced-repetition",
    "developer-tools",
    "cli",
    "ai",
    "claude",
    "github",
    "pr",
    "onboarding"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "poppr": "dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "audit:bank": "node scripts/audit-bank.mjs",
    "test": "npm run build && npm run audit:bank && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm run audit:bank",
    "demo": "node demo/frames.mjs > /tmp/poppr-frames.json && python3 demo/render.py /tmp/poppr-frames.json demo/poppr.gif",
    "build:web": "npm run build && node scripts/build-web.mjs",
    "test:deep": "npm run build && node scripts/deep-test.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuokkaPride/PopPR.git"
  },
  "bugs": {
    "url": "https://github.com/QuokkaPride/PopPR/issues"
  },
  "homepage": "https://github.com/QuokkaPride/PopPR#readme",
  "author": "QuokkaPride",
  "publishConfig": {
    "access": "public"
  }
}
